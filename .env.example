# Copy this file to .env and fill in your values:
#   copy .env.example .env

SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True

# False = local disk for static/media (and SQLite unless RDS_* is set)
# True  = Amazon S3 for static/media. Requires the AWS_* values below.
USE_AWS=False

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=tiendadjango

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Catálogo concurrente (demo F12 Console)
# CATALOG_SIMULATE_DB_FAILURE=True  -> fuerza fallback a CSV (simula RDS caído)
# CATALOG_SIMULATE_DB_DELAY_MS=1500  -> retrasa el hilo DB para ver el paralelismo
CATALOG_DB_TIMEOUT_SECONDS=3
CATALOG_SIMULATE_DB_FAILURE=False
CATALOG_SIMULATE_DB_DELAY_MS=0
