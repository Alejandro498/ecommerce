container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py migrate"
    leader_only: true
  03_import_pc_parts:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py import_pc_parts"
    leader_only: true
option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: ecommerce.settings
    USE_AWS: 'True'
  aws:elasticbeanstalk:command:
    Timeout: 1800
